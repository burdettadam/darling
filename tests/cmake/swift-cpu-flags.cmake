get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
list(APPEND CMAKE_MODULE_PATH "${root}/cmake")
include(darling_swift)
# ARM64 is enabled for the whole build, including while selecting x86_64 flags.
set(TARGET_ARM64 TRUE)
foreach(cpu generic cortex-a76)
 set(DARLING_ARM64_CPU "${cpu}")
 _darling_swift_cpu_flags(flags arm64)
 if(NOT "${flags}" STREQUAL "-target-cpu;${cpu}")
  message(FATAL_ERROR "wrong ARM64 flags for ${cpu}")
 endif()
 _darling_swift_cpu_flags(flags x86_64)
 if(flags)
  message(FATAL_ERROR "ARM64 CPU leaked to the x86_64 slice")
 endif()
endforeach()
set(TARGET_ARM64 FALSE)
_darling_swift_cpu_flags(flags x86_64)
if(flags)
 message(FATAL_ERROR "CPU leaked to other architectures")
endif()
